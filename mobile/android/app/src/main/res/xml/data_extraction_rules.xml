<?xml version="1.0" encoding="utf-8"?>
<!-- App keuangan — data lokal sensitif, ga boleh naik ke cloud backup / D2D
     transfer (selaras goal privasi PRD). allowBackup="false" udah nutup
     Android <12; ini buat Android 12+. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
